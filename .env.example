# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in the Node process; the browser only ever sees a ten-minute
# client secret minted from it.
OPENAI_API_KEY=sk-...

# Which voice the picker opens on: ash, alloy, ballad, cedar, coral, echo, marin,
# sage, shimmer, verse.
# OPENAI_VOICE=ash

# Preselected in the model picker when the key can reach it.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Point the proxy at a gateway or a stub instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Memory: the remember/forget tools, and the memory block in the prompt. The
# list itself lives in the browser — set this to false to switch the whole
# feature off for everyone the server serves.
# MEMORY=true

# Coding agents Tater may hand work to. Off unless this names one: a connector
# runs a CLI that edits real files, so it is opt-in on the machine that would be
# edited. Known: claude, codex, opencode, grok. Everything below can also be set
# from the connectors panel, which writes connectors.json and survives a restart.
# CONNECTORS=claude,codex

# Where the agents work, and the limits on them.
# CONNECTOR_CWD=/path/to/the/repo
# CONNECTOR_TIMEOUT=900        # seconds before a task is stopped
# CONNECTOR_LIMIT=3            # how many may run at once
# CONNECTOR_FILE=connectors.json
# CONNECTOR_ANNOUNCE=true      # tell Tater when a task finishes

# Per agent. The command line is deliberately not editable from the browser —
# that is choosing which binary this server executes, not configuring a tool.
# CLAUDE_COMMAND=claude
# CLAUDE_MODEL=
# CLAUDE_PERMISSION_MODE=acceptEdits
# CLAUDE_ARGS=
# CLAUDE_CWD=
# CODEX_SANDBOX=workspace-write
# OPENCODE_PERMISSION_MODE=default
# GROK_PERMISSION_MODE=acceptEdits

# PORT=5173
